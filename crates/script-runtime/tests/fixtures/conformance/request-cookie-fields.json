{
  "invocation": {
    "phase": "request",
    "request": {
      "url": "https://api.example.test/",
      "method": "GET",
      "headers": [
        ["cookie", "a=1"],
        ["accept", "*/*"],
        ["cookie", "b=2"]
      ]
    }
  },
  "expect": {
    "status": "done",
    "mutation": {
      "headers": [
        ["cookie", "a=1"],
        ["cookie", "b=2"],
