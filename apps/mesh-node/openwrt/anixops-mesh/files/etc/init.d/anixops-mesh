#!/bin/sh /etc/rc.common
# procd service of the mesh device (docs/deploy/openwrt.md). The networks
# come from the panel; UCI only says whether the service runs and which
# panel it enrolled with. The device state lives in /etc/anixops-mesh, a
# fixed place: it holds the device token and keys, so it is not a setting
# that the web interface's UCI write access could move (for example under
# /www).

# shellcheck disable=SC2034 # read by /etc/rc.common
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

STATE_DIR=/etc/anixops-mesh
SERVICE=/usr/libexec/anixops-mesh/service
FIREWALL=/usr/libexec/anixops-mesh/firewall

start_service() {
	local enabled

	config_load anixops-mesh
	config_get_bool enabled main enabled 0

	if [ "${enabled}" != 1 ]; then
		# Nothing runs: no port stays open for it.
		"${FIREWALL}" clear
		return 0
	fi
	# Without a device token there is nothing to run: the device is not
	# enrolled yet, or the panel revoked it (exit code 8 removed the token).
	if [ ! -s "${STATE_DIR}/token" ]; then
		"${FIREWALL}" clear
		logger -t anixops-mesh -p daemon.notice "not enrolled; enroll from LuCI or with anixops-mesh enroll"
		return 0
	fi

	procd_open_instance device
	procd_set_param command "${SERVICE}" "${STATE_DIR}"
	# Restart after every crash, 5 s apart, without a limit: a router must
	# rejoin once the cause (for example the uplink) is gone. Exit code 8
	# (token revoked) stops the service in the wrapper instead.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	# The wrapper kills the program itself 25 s after passing SIGTERM on,
	# before procd would kill the wrapper alone.
	procd_set_param term_timeout 30
	procd_close_instance

	# Keeps the firewall rules in step with the configuration the panel
	# delivers (listening ports, approved subnets); removes them on stop.
	procd_open_instance firewall
	procd_set_param command "${FIREWALL}" watch
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger anixops-mesh
}
