#!/bin/sh /etc/rc.common
# procd service of the mesh device (docs/deploy/openwrt.md). The networks
# come from the panel; UCI only says whether the service runs, which panel
# it enrolled with and where the device state lives.

# shellcheck disable=SC2034 # read by /etc/rc.common
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

SERVICE=/usr/libexec/anixops-mesh/service

start_service() {
	local enabled state_dir

	config_load anixops-mesh
	config_get_bool enabled main enabled 0
	config_get state_dir main state_dir /etc/anixops-mesh

	[ "${enabled}" = 1 ] || return 0
	# Without a device token there is nothing to run: the device is not
	# enrolled yet, or the panel revoked it (exit code 8 removed the token).
	if [ ! -s "${state_dir}/token" ]; then
		logger -t anixops-mesh -p daemon.notice "not enrolled; enroll from LuCI or with anixops-mesh enroll"
		return 0
	fi

	procd_open_instance device
	procd_set_param command "${SERVICE}" "${state_dir}"
	# Restart after a crash, at most 5 times within an hour, 5 s apart.
	# Exit code 8 (token revoked) stops the service in the wrapper instead.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger anixops-mesh
}
