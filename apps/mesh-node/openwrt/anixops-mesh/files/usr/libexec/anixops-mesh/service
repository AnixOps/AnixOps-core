#!/bin/sh
# Runs `anixops-mesh device` under procd (docs/deploy/openwrt.md).
#
# procd restarts an instance on any exit, but exit code 8 means the panel
# revoked the device token (the program already removed it): restarting
# cannot help, so the service is stopped instead and stays stopped until
# the device is enrolled again. Other exit codes are passed on so that
# procd's respawn limits apply.
#
#   service STATE_DIR

PROGRAM=/usr/bin/anixops-mesh
INIT=/etc/init.d/anixops-mesh

if [ "$#" -ne 1 ]; then
	echo "usage: $0 STATE_DIR" >&2
	exit 2
fi
state_dir="$1"

child=
killer=
# shellcheck disable=SC2329 # invoked by the trap below
forward() {
	if [ -n "${child}" ] && [ -z "${killer}" ]; then
		kill -TERM "${child}" 2>/dev/null
		# procd kills this wrapper 30 s after SIGTERM (term_timeout), and
		# only the wrapper: the program would be left running with its
		# interface and ports. Kill it first if it has not stopped by then.
		(sleep 25; kill -KILL "${child}" 2>/dev/null) &
		killer=$!
	fi
}
# procd stops the service with SIGTERM to this process: pass it on and wait
# for the program to stop its networks.
trap forward TERM INT

"${PROGRAM}" device --state-dir "${state_dir}" &
child=$!
while :; do
	wait "${child}"
	code=$?
	# wait returns early (code > 128) when a trapped signal arrives while
	# the program still runs; wait again for its own exit code.
	if kill -0 "${child}" 2>/dev/null; then
		continue
	fi
	# The program may have exited while the trap ran: the shell keeps its
	# status until it is waited for, so ask once more. A program already
	# waited for is unknown to wait (127), and the code above stands.
	wait "${child}"
	again=$?
	if [ "${again}" -ne 127 ]; then
		code="${again}"
	fi
	break
done
if [ -n "${killer}" ]; then
	kill "${killer}" 2>/dev/null
fi

if [ "${code}" -eq 8 ]; then
	logger -t anixops-mesh -p daemon.warn "device token revoked by the panel; service stopped until the device is enrolled again"
	"${INIT}" stop
	exit 0
fi
exit "${code}"
